# ============================================================
# DRIP VIETNAMESE CAFE — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# Found in: supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── RESEND (Email) ───────────────────────────────────────────
# Found in: resend.com → API Keys → Create API Key
# Sign up free at resend.com — no credit card required.
RESEND_API_KEY=re_your-api-key-here
ADMIN_EMAIL=brezzythetrapper@gmail.com
FROM_EMAIL=Drip Vietnamese Cafe <orders@resend.dev>

# ── STRIPE ───────────────────────────────────────────────────
# Found in: dashboard.stripe.com → Developers → API Keys
# Use sk_test_... / pk_test_... to stay in mock/test mode.
# Swap to sk_live_... / pk_live_... to accept real payments.
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# ── AUTH ─────────────────────────────────────────────────────
# Generate a strong random string (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret

# ── APP ──────────────────────────────────────────────────────
NODE_ENV=development
